--==================================================
-- SOUND
--==================================================

local oldSound = SoundService:FindFirstChild("KIOMusic")
if oldSound then oldSound:Destroy() end

local sound = create("Sound", {
    Name = "KIOMusic",
    Volume = volume,
    PlaybackSpeed = 1,
    Looped = false
}, SoundService)

local function updateVolume()
    volume = math.clamp(volume, 0, 1)
    sound.Volume = volume
    volumeLabel.Text = "Âm lượng "
        .. math.floor(volume * 100 + 0.5) .. "%"
end

minusButton.Activated:Connect(function()
    volume -= 0.1
    updateVolume()
end)

plusButton.Activated:Connect(function()
    volume += 0.1
    updateVolume()
end)

stopButton.Activated:Connect(function()
    sound:Stop()
    status.Text = "Trạng thái: Đã dừng"
end)

local function applyMusicSpeed()
    local value = tonumber(speedInput.Text)

    if not value or value < 0.1 or value > 3 then
        status.Text = "Nhập tốc độ từ 0.1 đến 3"
        return
    end

    sound.PlaybackSpeed = value
    speedInput.Text = tostring(value)
    status.Text = "Tốc độ nhạc: " .. tostring(value) .. "x"
end

applySpeedButton.Activated:Connect(applyMusicSpeed)

speedInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        applyMusicSpeed()
    end
end)

--==================================================
-- MUSIC LIST
--==================================================

local function updateCanvas()
    scroll.CanvasSize = UDim2.fromOffset(
        0, listLayout.AbsoluteContentSize.Y + 16
    )
end

listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

local function showMusicList(ids)
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for index, id in ipairs(ids) do
        local musicButton = button(
            scroll,
            string.format("♫ NHẠC %02d | ID: %s", index, id),
            UDim2.new(1, -2, 0, 34),
            UDim2.new()
        )

        musicButton.Name = "Music_" .. index
        musicButton.LayoutOrder = index

        musicButton.Activated:Connect(function()
            sound:Stop()
            sound.SoundId = "rbxassetid://" .. id

            local ok, err = pcall(function()
                sound:Play()
            end)

            if ok then
                status.Text = "Đang phát ID: " .. id
            else
                status.Text = "Không phát được audio"
                warn("KIO audio error:", err)
            end
        end)
    end

    updateCanvas()
    scroll.CanvasPosition = Vector2.zero

    task.defer(function()
        updateCanvas()
        scroll.CanvasPosition = Vector2.zero
    end)
end

--==================================================
-- TAB SWITCHING
--==================================================

local function showTab(tab)
    if tab == "VIET" then
        navVN.BackgroundColor3 = Color3.fromRGB(75, 45, 105)
        navHot.BackgroundColor3 = Color3.fromRGB(31, 31, 46)
        showMusicList(VietnameseMusic)
    else
        navHot.BackgroundColor3 = Color3.fromRGB(75, 45, 105)
        navVN.BackgroundColor3 = Color3.fromRGB(31, 31, 46)
        showMusicList(HotMusic)
    end
end

navVN.Activated:Connect(function()
    showTab("VIET")
end)

navHot.Activated:Connect(function()
    showTab("HOT")
end)

--==================================================
-- OPEN / CLOSE
--==================================================

local panelOpen = true
local busy = false

local function setPanel(open)
    if busy or open == panelOpen then return end

    busy = true
    panelOpen = open

    if open then
        main.Visible = true
        toggle.Visible = false
        main.Size = UDim2.fromOffset(260, 330)

        local tween = TweenService:Create(
            main,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(310, 390)}
        )

        tween:Play()
        tween.Completed:Wait()
    else
        local tween = TweenService:Create(
            main,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad,
                Enum.EasingDirection.In),
            {Size = UDim2.fromOffset(0, 0)}
        )

        tween:Play()
        tween.Completed:Wait()

        main.Visible = false
        main.Size = UDim2.fromOffset(310, 390)
        toggle.Visible = true
    end

    busy = false
end

toggle.Activated:Connect(function()
    if not panelOpen then
        setPanel(true)
    end
end)

closeButton.Activated:Connect(function()
    if panelOpen then
        setPanel(false)
    end
end)

--==================================================
-- START

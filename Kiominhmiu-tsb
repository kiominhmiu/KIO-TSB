local bubbleContainer = Instance.new("Frame")
bubbleContainer.Size = UDim2.fromScale(1, 1)
bubbleContainer.BackgroundTransparency = 1
bubbleContainer.BorderSizePixel = 0
bubbleContainer.ZIndex = 30
bubbleContainer.Parent = main

local beatPower = 0

local function createBubble(power)
	local bubble = Instance.new("Frame")

	local size = math.random(7, 14)
	local edge = math.random(1, 4)

	local x
	local y

	if edge == 1 then
		x = math.random(0, 320)
		y = 0
	elseif edge == 2 then
		x = 320
		y = math.random(0, 400)
	elseif edge == 3 then
		x = math.random(0, 320)
		y = 400
	else
		x = 0
		y = math.random(0, 400)
	end

	bubble.Size = UDim2.new(0, size, 0, size)
	bubble.Position = UDim2.new(0, x, 0, y)
	bubble.BackgroundColor3 = Color3.fromHSV(math.random(), 0.9, 1)
	bubble.BorderSizePixel = 0
	bubble.ZIndex = 31
	bubble.Parent = bubbleContainer

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = bubble

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = bubble.BackgroundColor3
	stroke.Parent = bubble

	local grow = 1.8 + (power * 1.8)

	local targetX = x + math.random(-40, 40)
	local targetY = y - math.random(40, 110)

	local tween = TweenService:Create(
		bubble,
		TweenInfo.new(
			math.random(15, 25) / 10,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(0, targetX, 0, targetY),
			Size = UDim2.new(0, size * grow, 0, size * grow),
			BackgroundTransparency = 1
		}
	)

	local strokeTween = TweenService:Create(
		stroke,
		TweenInfo.new(2),
		{
			Transparency = 1
		}
	)

	tween:Play()
	strokeTween:Play()

	tween.Completed:Connect(function()
		if bubble then
			bubble:Destroy()
		end
	end)
end


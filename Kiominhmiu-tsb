-- Một số tên map phổ biến được bảo vệ
local protectedNames = {
	ground = true,
	baseplate = true,
	terrain = true,
	part = true,
	meshpart = true,
	union = true,
	floor = true,
	wall = true,
	map = true,
}

local function hasRemoveWord(name)
	name = string.lower(name)

	if protectedNames[name] then
		return false
	end

	for _, word in ipairs(removeWords) do
		if string.find(name, word, 1, true) then
			return true
		end
	end

	return false
end

local function shouldRemoveObject(obj)
	if effectClasses[obj.ClassName] then
		return true
	end

	if hasRemoveWord(obj.Name) then
		return true
	end

	return false
end

local function cleanObject(obj)
	if not obj or not obj.Parent then
		return
	end

	if shouldRemoveObject(obj) then
		pcall(function()
			obj:Destroy()
		end)

		return
	end

	-- Xoá màu/ánh sáng trực tiếp gắn trên object
	if obj:IsA("BasePart") then
		-- Chỉ xử lý những part có tên rõ ràng là hiệu ứng.
		if hasRemoveWord(obj.Name) then
			pcall(function()
				obj:Destroy()
			end)
			return
		end
	end
end

local function cleanWorkspace()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		cleanObject(obj)
	end
end

local function startFixLag()
	if fixLagEnabled then
		return
	end

	fixLagEnabled = true
	fixLagButton.Text = "FIX LAG: ON"

	-- Dọn toàn bộ hiệu ứng hiện tại
	cleanWorkspace()

	-- Dọn ngay khi skill spawn effect mới
	fixLagConnection = Workspace.DescendantAdded:Connect(function(obj)
		if not fixLagEnabled then
			return
		end

		cleanObject(obj)

		task.defer(function()
			if not fixLagEnabled then
				return
			end

			if not obj or not obj.Parent then
				return
			end

			cleanObject(obj)

			for _, child in ipairs(obj:GetDescendants()) do
				cleanObject(child)
			end
		end)
	end)
end

local function stopFixLag()
	fixLagEnabled = false
	fixLagButton.Text = "FIX LAG: OFF"

	if fixLagConnection then
		fixLagConnection:Disconnect()
		fixLagConnection = nil
	end
end

fixLagButton.MouseButton1Click:Connect(function()
	if fixLagEnabled then
		stopFixLag()
	else
		startFixLag()
	end
end)


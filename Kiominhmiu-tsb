-- KIO OPEN / CLOSE
--==================================================

local panelOpen = false
local animating = false

local function openPanel()
	if animating or panelOpen then
		return
	end

	animating = true
	panelOpen = true

	main.Visible = true

	local buttonPos = kioButton.AbsolutePosition
	local buttonSize = kioButton.AbsoluteSize

	local centerX = workspace.CurrentCamera.ViewportSize.X / 2
	local centerY = workspace.CurrentCamera.ViewportSize.Y / 2

	main.Position = UDim2.new(
		0,
		buttonPos.X + buttonSize.X / 2,
		0,
		buttonPos.Y + buttonSize.Y / 2
	)

	mainScale.Scale = 0.15

	local moveTween = TweenService:Create(
		main,
		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}
	)

	local scaleTween = TweenService:Create(
		mainScale,
		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Scale = 1
		}
	)

	moveTween:Play()
	scaleTween:Play()

	scaleTween.Completed:Wait()

	animating = false
end

local function closePanel()
	if animating or not panelOpen then
		return
	end

	animating = true
	panelOpen = false

	local buttonPos = kioButton.AbsolutePosition
	local buttonSize = kioButton.AbsoluteSize

	local targetX = buttonPos.X + buttonSize.X / 2
	local targetY = buttonPos.Y + buttonSize.Y / 2

	local moveTween = TweenService:Create(
		main,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),
		{
			Position = UDim2.new(
				0,
				targetX,
				0,
				targetY
			)
		}
	)

	local scaleTween = TweenService:Create(
		mainScale,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		),
		{
			Scale = 0.15
		}
	)

	moveTween:Play()
	scaleTween:Play()

	scaleTween.Completed:Wait()

	main.Visible = false
	animating = false
end

kioButton.MouseButton1Click:Connect(function()
	if panelOpen then
		closePanel()
	else
		openPanel()
	end
end)

--==================================================
-- RAINBOW + MUSIC BUBBLES
--==================================================

local hue = 0
local lastBubble = 0

RunService.RenderStepped:Connect(function(deltaTime)
	hue = (hue + deltaTime * 0.15) % 1

	local rainbow = Color3.fromHSV(hue, 1, 1)

	mainStroke.Color = rainbow
	toggleStroke.Color = rainbow
	bomboxStroke.Color = rainbow
	fixStroke.Color = rainbow

	local loudness = 0

	if currentSound and currentSound.IsPlaying then
		loudness = math.clamp(
			currentSound.PlaybackLoudness / 250,
			0,
			1
		)
	end

	beatPower = beatPower + (loudness - beatPower) * 0.18

	local now = os.clock()

	if currentSound and currentSound.IsPlaying then
		local interval = 0.28 - (beatPower * 0.16)

		if now - lastBubble >= interval then
			lastBubble = now

			local amount = 1

			if beatPower > 0.65 then
				amount = 2
			end

			for i = 1, amount do
				createBubble(beatPower)
			end
		end
	end

	mainStroke.Thickness = 2.5 + (beatPower * 2.5)
end)


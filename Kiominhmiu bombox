local function ShowCategory(category)
    CurrentCategory = category

    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local ids

    if category == "nhac Viet 🇻🇳" then
        ids = VietnameseMusic
        VietnamButton.BackgroundColor3 = Color3.fromRGB(94, 49, 145)
        HotButton.BackgroundColor3 = Color3.fromRGB(31, 29, 43)
    else
        ids = HotMusic
        HotButton.BackgroundColor3 = Color3.fromRGB(125, 66, 35)
        VietnamButton.BackgroundColor3 = Color3.fromRGB(31, 29, 43)
    end

    Status.Text = category .. " • " .. #ids .. " bài"

    for index, id in ipairs(ids) do
        local songButton = MakeButton(
            List,
            string.format("♫  Bài %02d     •     %s", index, id),
            UDim2.new(1, -2, 0, 39),
            UDim2.new()
        )

        songButton.LayoutOrder = index
        songButton.TextSize = 12
        songButton.TextXAlignment = Enum.TextXAlignment.Left

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 10)
        padding.PaddingRight = UDim.new(0, 5)
        padding.Parent = songButton

        songButton.Activated:Connect(function()
            PlayMusic(id, index)
        end)
    end

    List.CanvasPosition = Vector2.zero
end


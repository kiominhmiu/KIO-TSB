local function StopMusic()
    if CurrentSound then
        CurrentSound:Stop()
        CurrentSound:Destroy()
        CurrentSound = nil
    end

    Status.Text = "Đã dừng nhạc"
end

local function PlayMusic(id, number)
    StopMusic()

    SongNumber = number

    local sound = Instance.new("Sound")
    sound.Name = "KIO_Boombox_Sound"
    sound.SoundId = "rbxassetid://" .. id
    sound.Volume = 0.5
    sound.Looped = false
    sound.Parent = SoundService

    CurrentSound = sound
    Status.Text = "Đang tải bài " .. number .. "..."

    sound.Loaded:Connect(function()
        if CurrentSound == sound then
            Status.Text = "Đang phát bài " .. number
        end
    end)

    sound.Ended:Connect(function()
        if CurrentSound == sound then
            CurrentSound = nil
            Status.Text = "Bài nhạc đã kết thúc"
            sound:Destroy()
        end
    end)

    sound:Play()

    task.delay(8, function()
        if CurrentSound == sound and not sound.IsPlaying then
            Status.Text = "Không phát được? Kiểm tra quyền audio"
        end
    end)
end


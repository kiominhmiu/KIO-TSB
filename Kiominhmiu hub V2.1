local function IsValidNPC(model)

	if not model:IsA("Model") then
		return false
	end

	for _,player in ipairs(Players:GetPlayers()) do
		if player.Character == model then
			return false
		end
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	return humanoid
		and root
		and humanoid.Health > 0
end

local function RefreshTargets()

	for _,child in ipairs(TargetScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local found = 0

	for _,object in ipairs(Workspace:GetDescendants()) do

		if IsValidNPC(object) then

			found += 1

			local button = CreateButton(
				TargetScroll,
				object.Name,
				UDim2.new(1,-5,0,34),
				UDim2.new()
			)

			button.ZIndex = 52

			button.MouseButton1Click:Connect(function()

				if IsValidNPC(object) then

					AimTarget = object

					AimTargetButton.Text =
						"TARGET: "..object.Name

					Status.Text =
						"Target: "..object.Name

					TargetFrame.Visible = false

				end
			end)
		end
	end

	if found == 0 then

		local none = Instance.new("TextLabel")
		none.Size = UDim2.new(1,-5,0,35)
		none.BackgroundTransparency = 1
		none.Text = "NO NPC FOUND"
		none.TextColor3 = Color3.fromRGB(150,150,160)
		none.Font = Enum.Font.Gotham
		none.TextSize = 13
		none.ZIndex = 52
		none.Parent = TargetScroll

	end

	task.wait()

	TargetScroll.CanvasSize = UDim2.new(
		0,0,
		0,
		TargetLayout.AbsoluteContentSize.Y + 10
	)
end

AimTargetButton.MouseButton1Click:Connect(function()


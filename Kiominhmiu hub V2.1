local function SetAim(state)

	AimEnabled = state

	if AimEnabled then

		AimToggle.Text = "AIM: ON"
		AimButton.Visible = true
		PlayerAimButton.Visible = true

		Status.Text = "AIM ON"

		StartAim()

	else

		AimToggle.Text = "AIM: OFF"
		AimButton.Visible = false
		PlayerAimButton.Visible = false

		Status.Text = "Ready"

		if AimConnection then
			AimConnection:Disconnect()
			AimConnection = nil
		end
	end
end


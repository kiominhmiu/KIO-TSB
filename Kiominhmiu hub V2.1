local FixLagToggle = CreateButton(
	Main,"FIX LAG: OFF",
	UDim2.new(0,155,0,40),
	UDim2.new(0,15,0,205)
)

local EffectClasses = {
	ParticleEmitter = true,
	Trail = true,
	Beam = true,
	Smoke = true,
	Fire = true,
	Sparkles = true,
	PointLight = true,
	SpotLight = true,
	SurfaceLight = true,
	Highlight = true,
	Explosion = true
}

local EffectKeywords = {
	"effect","effects","vfx","skill","debris",
	"dust","smoke","rock","rocks","fragment",
	"fragments","tree","trees","grounddebris",
	"ground_debris","screen_shake","screenshake"
}

local ProtectedNames = {
	ground = true,
	baseplate = true,
	terrain = true,
	map = true,
	spawn = true
}

local function ShouldRemove(object)

	if EffectClasses[object.ClassName] then
		return true
	end

	local name = string.lower(object.Name)

	if ProtectedNames[name] then
		return false
	end

	for _, keyword in ipairs(EffectKeywords) do
		if string.find(name,keyword,1,true) then
			return true
		end
	end

	return false
end

local function CleanEffects()
	for _, object in ipairs(Workspace:GetDescendants()) do
		if ShouldRemove(object) then
			pcall(function()
				object:Destroy()
			end)
		end
	end
end

FixLagToggle.MouseButton1Click:Connect(function()

	FixLagEnabled = not FixLagEnabled

	if FixLagEnabled then

		FixLagToggle.Text = "FIX LAG: ON"
		Status.Text = "Fix Lag: ON"

		CleanEffects()

		if FixLagConnection then
			FixLagConnection:Disconnect()
		end

		FixLagConnection =
			Workspace.DescendantAdded:Connect(function(object)

				if not FixLagEnabled then
					return
				end

				task.defer(function()

					if object
						and object.Parent
						and ShouldRemove(object) then

						pcall(function()
							object:Destroy()
						end)

					end
				end)

			end)

	else

		FixLagToggle.Text = "FIX LAG: OFF"
		Status.Text = "Ready"

		if FixLagConnection then
			FixLagConnection:Disconnect()
			FixLagConnection = nil
		end

	end
end)


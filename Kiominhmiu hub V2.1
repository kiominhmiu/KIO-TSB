	TargetFrame.Visible =
		not TargetFrame.Visible
end)

--==================================================
-- PLAYER IN FRONT
--==================================================

local function GetPlayerInFront()

	if not Character or not Root then
		return nil
	end

	local bestPlayer
	local bestDistance = math.huge

	local lookDirection =
		Root.CFrame.LookVector

	for _,otherPlayer in ipairs(Players:GetPlayers()) do

		if otherPlayer ~= Player
			and otherPlayer.Character then

			local char = otherPlayer.Character

			local humanoid =
				char:FindFirstChildOfClass("Humanoid")

			local targetRoot =
				char:FindFirstChild("HumanoidRootPart")

			if humanoid
				and targetRoot
				and humanoid.Health > 0 then

				local offset =
					targetRoot.Position - Root.Position

				local distance =
					offset.Magnitude

				if distance > 0 then

					local direction =
						offset.Unit

					local dot =
						lookDirection:Dot(direction)

					if dot > 0.5
						and distance < bestDistance then

						bestDistance = distance
						bestPlayer = otherPlayer
					end
				end
			end
		end
	end

	return bestPlayer
end

--==================================================
-- AIM LOOP
--==================================================

local function StartAim()

	if AimConnection then
		AimConnection:Disconnect()
	end

	AimConnection =
		RunService.RenderStepped:Connect(function()

			if not AimEnabled then
				return
			end

			-- PLAYER AIM
			if PlayerAimEnabled then

				local targetPlayer =
					GetPlayerInFront()

				if targetPlayer
					and targetPlayer.Character then

					local targetRoot =
						targetPlayer.Character:
						FindFirstChild("HumanoidRootPart")

					if targetRoot then

						Status.Text =
							"Player: "..targetPlayer.Name

						local camera =
							Workspace.CurrentCamera

						if camera then

							camera.CFrame =
								CFrame.lookAt(
									camera.CFrame.Position,
									targetRoot.Position
								)

						end
					end
				else

					Status.Text =
						"PLAYER AIM: No player"

				end

				return
			end

			-- NPC AIM
			if AimTarget
				and AimTarget.Parent then

				local humanoid =
					AimTarget:
					FindFirstChildOfClass("Humanoid")

				local targetRoot =
					AimTarget:
					FindFirstChild("HumanoidRootPart")

				if humanoid
					and targetRoot
					and humanoid.Health > 0 then

					local camera =
						Workspace.CurrentCamera

					if camera then

						camera.CFrame =
							CFrame.lookAt(
								camera.CFrame.Position,
								targetRoot.Position
							)

					end

				else

					AimTarget = nil
					AimTargetButton.Text =
						"SELECT NPC"

					Status.Text =
						"Target lost"

				end
			end

		end)
end


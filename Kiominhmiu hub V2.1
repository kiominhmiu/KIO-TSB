local function Round(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
end

local function RainbowStroke(obj)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = obj

	task.spawn(function()
		local hue = 0

		while stroke.Parent do
			hue = (hue + 0.005) % 1
			stroke.Color = Color3.fromHSV(hue, 1, 1)
			task.wait()
		end
	end)

	return stroke
end

local function MakeDraggable(obj)
	local dragging = false
	local dragStart
	local startPos

	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = obj.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			obj.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function CreateButton(parent, text, size, position)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = position
	b.BackgroundColor3 = Color3.fromRGB(25,25,35)
	b.TextColor3 = Color3.new(1,1,1)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.AutoButtonColor = false
	b.Parent = parent

	Round(b, 10)

	return b
end

local function CreateInput(parent, placeholder, value, position)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0,100,0,34)
	box.Position = position
	box.BackgroundColor3 = Color3.fromRGB(22,22,30)
	box.TextColor3 = Color3.new(1,1,1)
	box.PlaceholderColor3 = Color3.fromRGB(150,150,150)
	box.PlaceholderText = placeholder
	box.Text = tostring(value)
	box.Font = Enum.Font.Gotham
	box.TextSize = 13
	box.ClearTextOnFocus = false
	box.Parent = parent

	Round(box, 8)

	return box
end


        end
    end

    status.Text = name .. " • " .. #ids .. " bài"

    for index, id in ipairs(ids) do
        local song = button(
            list,
            string.format("♫  Bài %02d  |  %s", index, id),
            UDim2.new(1, -2, 0, 38),
            UDim2.new(),
            Color3.fromRGB(38, 32, 50)
        )

        song.LayoutOrder = index
        song.TextSize = 12
        song.TextXAlignment = Enum.TextXAlignment.Left

        local inset = Instance.new("UIPadding")
        inset.PaddingLeft = UDim.new(0, 8)
        inset.Parent = song

        song.Activated:Connect(function()
            playMusic(id, index)
        end)

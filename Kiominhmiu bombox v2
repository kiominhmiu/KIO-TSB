--==================================================
-- AUDIO FUNCTIONS
--==================================================

local function stopMusic()
    playToken += 1

    local previous = currentSound
    currentSound = nil

    if previous then
        previous:Stop()
        previous:Destroy()
    end

    status.Text = "Đã dừng nhạc"
end

local function playMusic(id, index)
    stopMusic()
    local token = playToken

    local sound = Instance.new("Sound")
    sound.Name = "KIOBoomboxSound"
    sound.SoundId = "rbxassetid://" .. id
    sound.Volume = currentVolume
    sound.Parent = SoundService

    currentSound = sound
    status.Text = "Đang tải bài " .. index .. "..."

    sound.Loaded:Connect(function()
        if currentSound == sound and playToken == token then
            status.Text = "Đang phát bài " .. index
        end
    end)

    sound.Ended:Connect(function()
        if currentSound == sound then
            currentSound = nil
            sound:Destroy()
            status.Text = "Bài nhạc đã kết thúc"
        end
    end)

    sound:Play()

    task.delay(10, function()
        if currentSound == sound and playToken == token then
            if not sound.IsLoaded then
                status.Text = "Audio chưa tải được / bị hạn chế"
            elseif not sound.IsPlaying then
                status.Text = "Không phát được audio này"
            end
        end
    end)
end


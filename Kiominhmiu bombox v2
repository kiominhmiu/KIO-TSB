        vnButton.BackgroundColor3 = Color3.fromRGB(90, 48, 140)
        hotButton.BackgroundColor3 = Color3.fromRGB(36, 32, 48)
    else
        hotButton.BackgroundColor3 = Color3.fromRGB(130, 65, 35)
        vnButton.BackgroundColor3 = Color3.fromRGB(36, 32, 48)
    end
end

